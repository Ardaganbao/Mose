# Per-computer on/off settings written by Manager.ps1.
scripts.local.json

# Modules of the client configured on this computer, written by Configure.ps1 and Report.ps1.
modules.local.json

# Git commit this folder was last updated to, written by Start.ps1.
installed-version.txt

# GitHub token saved by Start.ps1, encrypted for one Windows user on one computer.
github-token.xml

# Vault password and log written by Renew-CommvaultToken.ps1.
*.password.xml
Renew-CommvaultToken.log

# Reports contain client data and stay on the computer that made them.
*_Report_*.md
CommvaultReport_*.md

# Debug logs of Report.ps1 -DebugLog and iloreport.ps1 -StorageDebugPath name the client's servers too.
*_Debug_*.log

# Lists the audit downloads and keeps: MAC vendors, Microsoft licence names.
audit-cache/

# Audits (Audit.ps1) describe a client's network, accounts and devices, and so does their diagram.
*_Audit_*.md
*_Audit_*.json
*_Audit_*.drawio

# The Subscriptions page of a Commvault Cloud, exported as CSV and kept by Report.ps1, is client data.
Subscriptions_*.csv

# Keeper exports hold passwords: they never leave the computer that made them.
Keeper_Export_*

# The RDP connections of a Keeper Connection Manager, written by Keeper.ps1, name the client's servers.
KCM-RDP-Drive-Report_*.csv

# The addresses and data sources of the Keeper Connection Managers used on this computer (Keeper.ps1).
keeper.local.json

# The connections as they were before a Keeper.ps1 import, which may hold their passwords.
KCM-RDP-Backup_*.json


# ignore audit logs and reports from the audit scripts, which contain client data
*_Audit_*.md
*_Audit_*.log
*_Audit_*.csv
*_Audit_*.json
*_Audit_*.xml
*_Audit_*.drawio